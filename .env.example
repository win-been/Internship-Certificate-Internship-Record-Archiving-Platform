# Backend Environment Variables

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=internship_db
DB_USER=root
DB_PASSWORD=root

# JWT Configuration
JWT_SECRET=internship-platform-jwt-secret-key-must-be-at-least-sixty-four-bytes-long-for-hs512!!
JWT_EXPIRATION=86400000

# DeepSeek API Configuration
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_API_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# WeBASE Configuration
WEBASE_URL=http://your-webase-host:5002
WEBASE_API_PATH=/WeBASE-Front
WEBASE_GROUP_ID=group0
CERTIFICATE_CONTRACT_ADDRESS=0xyour-certificate-contract-address
RECORD_CONTRACT_ADDRESS=0xyour-record-contract-address
SCHOOL_ACCOUNT=0xyour-school-account
ENTERPRISE_ACCOUNT=0xyour-enterprise-account
SCHOOL_PRIVATE_KEY=your-school-private-key
ENTERPRISE_PRIVATE_KEY=your-enterprise-private-key

# Server Configuration
SERVER_PORT=8080
SERVER_SERVLET_CONTEXT_PATH=/api

# Frontend Environment Variables

# API Configuration
VITE_API_BASE_URL=http://localhost:8080/api

# Application Configuration
VITE_APP_NAME=实习证明存证平台
VITE_APP_VERSION=1.0.0
